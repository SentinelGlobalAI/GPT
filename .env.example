# Public Pixel ID. This must equal OPENAI_ADS_PIXEL_ID.
NEXT_PUBLIC_OPENAI_ADS_PIXEL_ID=

# Server-only OpenAI Ads configuration. Never use NEXT_PUBLIC_ for the API key.
OPENAI_ADS_PIXEL_ID=
OPENAI_ADS_CONVERSIONS_API_KEY=
OPENAI_ADS_SITE_ORIGIN=https://sentinelglobal.ai
OPENAI_ADS_VALIDATE_ONLY=false

# Lead delivery. A lead is not reported as a conversion unless delivery succeeds.
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=
LEAD_FROM_EMAIL=Sentinel Global <leads@sentinelglobal.ai>
